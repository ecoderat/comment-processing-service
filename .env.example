# Database
DATABASE_URL=postgres://comment:comment@localhost:5432/comment?sslmode=disable

# Redis
REDIS_ADDR=127.0.0.1:6379
REDIS_DB=0
REDIS_PASSWORD=password

# Kafka
KAFKA_BROKERS=127.0.0.1:9092
KAFKA_TOPIC=raw-comments
KAFKA_GROUP_ID=comment-ingest
KAFKA_PROCESSED_TOPIC=processed-comments

# Producer
PRODUCER_BURST_PERCENT=10
PRODUCER_BURST_INTERVAL=100ms
PRODUCER_BURST_COUNT=20

# Sentiment gRPC
SENTIMENT_GRPC_ADDR=127.0.0.1:50051

# Worker
MAX_ATTEMPTS=10
BACKOFF_BASE=200ms
BACKOFF_MAX=30s
BACKOFF_JITTER=200ms
LOCK_TTL=30s
RETRY_ZSET=retry:zset
TEXT_CACHE_TTL=168h
RPC_RATE_LIMIT=100
RPC_TIMEOUT=2s

# API
API_ADDR=:8080
